DJANGO_SECRET_KEY=django-inseguro-apenas-desenvolvimento
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Autenticação de serviço a serviço — serviços que chamam a auditoria
# (hoje o SME-Identidade-Gateway-Microsservico, para avisar atividade)
API_KEY=chave-secreta-dev
API_KEY_HEADER=X-API-Key

# Postgres — base dos eventos de auditoria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTIDADE_AUDITORIA_DB_NAME=identidade_auditoria
IDENTIDADE_AUDITORIA_DB_URL=postgresql://postgres:postgres@postgres/identidade_auditoria

# KeyDB — broker das filas de captura e de escrita
URL_KEYDB=redis://keydb:[port]/0

# Prefixo opcional das filas, para isolar um worker local de um broker
# compartilhado (ex.: KeyDB de QA). Vazio mantém as filas reais.
AUDITORIA_PREFIXO_FILA=

# Filas escutadas por este worker. Cada container do docker-compose
# sobe com o seu conjunto (ver docker-compose-dev.yml) — captura de
# usuário e captura de admin consultam canais independentes do
# Keycloak, e a escrita em lote é a etapa lenta que não deve segurar
# atrás de si a captura. Para rodar tudo num único worker local,
# liste as três: auditoria_captura_usuario,auditoria_captura_admin,
# auditoria_persistencia
AUDITORIA_WORKER_FILAS=auditoria_captura_usuario,auditoria_captura_admin,auditoria_persistencia

# Keycloak — origem única dos eventos. O realm precisa estar com
# eventsEnabled=true para que a Admin API exponha os eventos, e a
# credencial é de service account com permissão de leitura de eventos
KEYCLOAK_URL_SERVIDOR=[host]:[port]/
KEYCLOAK_REALM=COTIC
KEYCLOAK_CLIENT_ID=identidade-auditoria
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_VERIFICAR_SSL=true
KEYCLOAK_TIMEOUT=30

# Captura — tipos consultados, teto por leitura e intervalo do ciclo
# agendado (em minutos; piso a combinar com infra, já que um intervalo
# curto demais vira carga constante sobre o Keycloak)
AUDITORIA_TIPOS_EVENTO=LOGIN,LOGIN_ERROR,LOGOUT,REGISTER,UPDATE_PASSWORD,UPDATE_EMAIL
AUDITORIA_LIMITE_CONSULTA=500
AUDITORIA_INTERVALO_POLL_MINUTOS=5

# Escrita em lote — recalibrável conforme o volume observado
AUDITORIA_TAMANHO_LOTE=500

# Retenção e expurgo. Desligado por padrão: o período mínimo de guarda
# depende de definição jurídica, e a remoção é irreversível. Só ativar
# com a definição documentada
AUDITORIA_RETENCAO_DIAS=3650
AUDITORIA_EXPURGO_ATIVO=0
AUDITORIA_EXPURGO_TAMANHO_LOTE=1000
